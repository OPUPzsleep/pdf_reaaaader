{
  "name": "pdf_reaaaader",
  "productName": "pdfreaaaader",
  "version": "1.0.0",
  "description": "pdfreaaaader: herramientas de PDF e imágenes sin conexión, con PDF a EPUB",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "OPUPzsleep",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:web": "node scripts/copiar-recursos.mjs && vite build",
    "build": "npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "fetch-binaries": "powershell -ExecutionPolicy Bypass -File scripts/fetch-binaries.ps1",
    "postinstall": "node scripts/copiar-recursos.mjs",
    "icons": "node scripts/generar-iconos.mjs"
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@playwright/test": "^1.63.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.51.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
